# Copy this file to .env and fill in your keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Faster model for chat questions and home care (triage uses GROQ_MODEL)
GROQ_FAST_MODEL=openai/gpt-oss-20b
# low = fastest replies (low | medium | high)
GROQ_REASONING_EFFORT=low
# Doctor finder: free key, no card, from https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Optional: Google Places (needs a billing account); used first if set
GOOGLE_PLACES_API_KEY=
